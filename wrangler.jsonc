{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fvem50-web",
  "compatibility_date": "2026-10-19",
  // Solo se publica la carpeta public/. El resto del repositorio (instrucciones, guía, herramientas) no sale a internet.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  // Cada rama de propuesta tiene su propia dirección de vista previa
  "preview_urls": true,
  "observability": { "enabled": true }
}
