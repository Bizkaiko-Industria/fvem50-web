{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "50",
  "compatibility_date": "2026-10-19",
  // Solo se publica la carpeta public/. El resto del repositorio (instrucciones, guía, herramientas) no sale a internet.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // El dominio propio 50.fvem.es se gestiona fuera de esta configuración: el dominio fvem.es no está en esta cuenta
  // de Cloudflare, así que declararlo aquí hacía fallar cada publicación (error 10082). No volver a añadir «routes».
  "workers_dev": true,
  // Cada rama de propuesta tiene su propia dirección de vista previa
  "preview_urls": true,
  "observability": { "enabled": true }
}
